[
  {
    "doctype": "Custom Field",
    "module": "Blueline",
    "dt": "Customer",
    "fieldname": "custom_tin",
    "label": "TIN (Taxpayer Identification Number)",
    "fieldtype": "Data",
    "insert_after": "tax_id",
    "description": "Auto-saved on first invoice and auto-populated on future invoices"
  },
  {
    "doctype": "Custom Field",
    "module": "Blueline",
    "dt": "Customer",
    "fieldname": "custom_place_of_supply",
    "label": "Default Place of Supply",
    "fieldtype": "Data",
    "insert_after": "custom_tin",
    "default": "Sri Lanka"
  },
  {
    "doctype": "Custom Field",
    "module": "Blueline",
    "dt": "Customer",
    "fieldname": "custom_mode_of_payment",
    "label": "Default Mode of Payment",
    "fieldtype": "Data",
    "insert_after": "custom_place_of_supply"
  }
]
