    "fieldtype": "Data",
    "insert_after": "custom_bank_section"
  },
  {
    "doctype": "Custom Field",
    "name": "Company-custom_bank_account_number",
    "module": "Blueline",
    "dt": "Company",
    "fieldname": "custom_bank_account_number",
    "label": "Bank Account Number",
    "fieldtype": "Data",
    "insert_after": "custom_bank_name"
  },
  {
    "doctype": "Custom Field",
    "name": "Company-custom_bank_address",
    "module": "Blueline",
    "dt": "Company",
    "fieldname": "custom_bank_address",
    "label": "Bank Address",
    "fieldtype": "Small Text",
    "insert_after": "custom_bank_account_number"
  },
  {
    "doctype": "Custom Field",
    "name": "Customer-custom_tin",
    "module": "Blueline",
    "dt": "Customer",
    "fieldname": "custom_tin",
    "label": "TIN (Taxpayer Identification Number)",
    "fieldtype": "Data",
    "insert_after": "tax_id",
