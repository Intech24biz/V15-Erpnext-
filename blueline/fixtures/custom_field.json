    "fieldtype": "Data",
    "insert_after": "custom_tin"
  },
  {
    "doctype": "Custom Field",
    "name": "Company-custom_branch_code",
    "module": "Blueline",
    "dt": "Company",
    "fieldname": "custom_branch_code",
    "label": "Branch Code (for Invoice Serial)",
    "fieldtype": "Data",
    "insert_after": "custom_svat_no",
