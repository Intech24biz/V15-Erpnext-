  {
    "doctype": "Custom Field",
    "name": "Sales Invoice-custom_mode_of_payment",
    "module": "Blueline",
    "dt": "Sales Invoice",
    "fieldname": "custom_mode_of_payment",
    "label": "Mode of Payment",
    "fieldtype": "Data",
    "insert_after": "custom_place_of_supply"
  }
