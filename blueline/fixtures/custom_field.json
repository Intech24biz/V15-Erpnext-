[
  {
    "doctype": "Custom Field",
    "name": "Company-custom_tin",
    "module": "Blueline",
    "dt": "Company",
    "fieldname": "custom_tin",
    "label": "TIN (Taxpayer Identification Number)",
    "fieldtype": "Data",
    "insert_after": "tax_id",
    "description": "9-digit TIN issued by Commissioner General of Inland Revenue (Sri Lanka)"
  },
  {
    "doctype": "Custom Field",
    "name": "Company-custom_svat_no",
    "module": "Blueline",
